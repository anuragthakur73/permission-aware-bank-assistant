    {
      "cell_type": "code",
      "source": [
        "def hybrid_search_with_rerank(question, role, n_candidates=15, n_final=5):\n",
        "    \"\"\"\n",
        "    1. Get candidates from semantic search (ChromaDB) - already permission filtered.\n",
        "    2. Get candidates from keyword search (BM25) - then filter by permission.\n",
        "    3. Combine and remove duplicates.\n",
        "    4. Rerank the combined list with the cross-encoder.\n",
        "    5. Return the top n_final chunks.\n",
        "    \"\"\"\n",
        "    allowed_levels = get_allowed_access_levels(role)\n",
        "\n",
        "    # --- 1. Semantic search (permission-filtered at the database level) ---\n",
        "    semantic_results = collection.query(\n",
        "        query_texts=[question],\n",
        "        n_results=n_candidates,\n",
        "        where={\"access_level\": {\"$in\": allowed_levels}}\n",
        "    )\n",
        "    semantic_chunks = semantic_results[\"documents\"][0]\n",
        "    semantic_metas = semantic_results[\"metadatas\"][0]\n",
        "\n",
        "    # --- 2. Keyword search (BM25 searches everything, so we filter after) ---\n",
        "    tokenized_question = question.lower().split()\n",
        "    bm25_scores = bm25_index.get_scores(tokenized_question)\n",
        "\n",
        "    # Get indices of the top-scoring chunks overall\n",
        "    top_bm25_indices = sorted(\n",
        "        range(len(bm25_scores)), key=lambda i: bm25_scores[i], reverse=True\n",
        "    )[:n_candidates]\n",
        "\n",
        "    # IMPORTANT: filter BM25 results by permission before using them\n",
        "    bm25_chunks = []\n",
        "    bm25_metas = []\n",
        "    for i in top_bm25_indices:\n",
        "        if all_metadata[i][\"access_level\"] in allowed_levels:\n",
        "            bm25_chunks.append(all_chunks[i])\n",
        "            bm25_metas.append(all_metadata[i])\n",
        "\n",
        "    # --- 3. Combine both lists and remove duplicates (by doc_id + chunk text) ---\n",
        "    combined = list(zip(semantic_chunks, semantic_metas)) + list(zip(bm25_chunks, bm25_metas))\n",
        "    seen = set()\n",
        "    unique_combined = []\n",
        "    for chunk, meta in combined:\n",
        "        key = meta.get(\"doc_id\", \"\") + chunk[:50]  # simple de-duplication key\n",
        "        if key not in seen:\n",
        "            seen.add(key)\n",
        "            unique_combined.append((chunk, meta))\n",
        "\n",
        "    if not unique_combined:\n",
        "        return [], []\n",
        "\n",
        "    # --- 4. Rerank everything together with the cross-encoder ---\n",
        "    pairs = [[question, chunk] for chunk, meta in unique_combined]\n",
        "    scores = reranker.predict(pairs)\n",
        "\n",
        "    # Sort by the reranker's score, highest first\n",
        "    ranked = sorted(zip(unique_combined, scores), key=lambda x: x[1], reverse=True)\n",
        "\n",
        "    # --- 5. Return the top n_final ---\n",
        "    top_results = ranked[:n_final]\n",
        "    final_chunks = [item[0][0] for item in top_results]\n",
        "    final_metas = [item[0][1] for item in top_results]\n",
        "\n",
        "    return final_chunks, final_metas\n",
        "\n",
        "\n",
        "print(\"hybrid_search_with_rerank() is ready to use.\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "RywuMBofxSbS",
        "outputId": "b05618d3-7cf8-47a7-b8be-750dc6b0be1b"
      },
      "execution_count": 23,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "hybrid_search_with_rerank() is ready to use.\n"
          ]
        }
      ]
    },
