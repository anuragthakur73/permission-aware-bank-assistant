    {
      "cell_type": "code",
      "source": [
        "# This is our fake \"login system\". A real company would use proper\n",
        "# authentication (a password, company login, etc). For our practice\n",
        "# project, a simple role selector teaches the same core lesson.\n",
        "\n",
        "ROLE_PERMISSIONS = {\n",
        "    \"branch_officer\": [\"Public\", \"Internal\"],\n",
        "    \"credit_manager\": [\"Public\", \"Internal\", \"Credit-Confidential\"],\n",
        "    \"compliance_officer\": [\"Public\", \"Internal\", \"Credit-Confidential\", \"AML-Confidential\"],\n",
        "}\n",
        "\n",
        "def get_allowed_access_levels(role):\n",
        "    \"\"\"Given a role name, returns the list of access levels that role\n",
        "    is permitted to see.\"\"\"\n",
        "    if role not in ROLE_PERMISSIONS:\n",
        "        raise ValueError(\n",
        "            f\"Unknown role '{role}'. Choose from: {list(ROLE_PERMISSIONS.keys())}\"\n",
        "        )\n",
        "    return ROLE_PERMISSIONS[role]\n",
        "\n",
        "\n",
        "# Quick check\n",
        "for role in ROLE_PERMISSIONS:\n",
        "    print(role, \"can see:\", get_allowed_access_levels(role))"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "q4DUPM2nwrtg",
        "outputId": "4a76a93e-4340-4570-ec57-3ea5267797aa"
      },
      "execution_count": 16,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "branch_officer can see: ['Public', 'Internal']\n",
            "credit_manager can see: ['Public', 'Internal', 'Credit-Confidential']\n",
            "compliance_officer can see: ['Public', 'Internal', 'Credit-Confidential', 'AML-Confidential']\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# This simulates a person logging in. In a real system this would come\n",
        "# from a proper authentication check, not a manual choice.\n",
        "\n",
        "import ipywidgets as widgets\n",
        "from IPython.display import display\n",
        "\n",
        "role_dropdown = widgets.Dropdown(\n",
        "    options=list(ROLE_PERMISSIONS.keys()),\n",
        "    description=\"Log in as:\",\n",
        "    style={\"description_width\": \"initial\"}\n",
        ")\n",
        "\n",
        "display(role_dropdown)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 49,
          "referenced_widgets": [
            "23997084a890466b8334991aa0276f46",
            "536ebff8dd4145699750d6bc98860052",
            "ec92610c84bc49e4a015d9e8df4ac4e8"
          ]
        },
        "id": "PYSTEsNMw8aC",
        "outputId": "e1eb3f9e-79eb-442e-cf74-fab6051bbecb"
      },
      "execution_count": 17,
      "outputs": [
        {
          "output_type": "display_data",
          "data": {
            "text/plain": [
              "Dropdown(description='Log in as:', options=('branch_officer', 'credit_manager', 'compliance_officer'), style=D…"
            ],
            "application/vnd.jupyter.widget-view+json": {
              "version_major": 2,
              "version_minor": 0,
              "model_id": "23997084a890466b8334991aa0276f46"
            }
          },
          "metadata": {}
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# THIS IS THE KEY STEP FROM THE VIDEO.\n",
        "# We restrict WHICH chunks ChromaDB is even allowed to search through,\n",
        "# based on the logged-in role's permissions. Chunks outside that list\n",
        "# are never returned, so they can never reach the AI model later.\n",
        "\n",
        "def permission_filtered_search(question, role, n_results=5):\n",
        "    \"\"\"\n",
        "    Searches only the chunks that this role is allowed to see.\n",
        "    Returns the top matching chunks, or an empty list if none are allowed.\n",
        "    \"\"\"\n",
        "    allowed_levels = get_allowed_access_levels(role)\n",
        "\n",
        "    # ChromaDB's \"where\" filter restricts the search BEFORE it runs,\n",
        "    # not after. This is what makes it \"permission-aware\" rather than\n",
        "    # \"search everything, then hide the answer.\"\n",
        "    results = collection.query(\n",
        "        query_texts=[question],\n",
        "        n_results=n_results,\n",
        "        where={\"access_level\": {\"$in\": allowed_levels}}\n",
        "    )\n",
        "\n",
        "    chunks = results[\"documents\"][0]\n",
        "    metadatas = results[\"metadatas\"][0]\n",
        "\n",
        "    return chunks, metadatas\n",
        "\n",
        "\n",
        "# Test it with the currently selected role\n",
        "current_role = role_dropdown.value\n",
        "print(f\"Testing as role: {current_role}\\n\")\n",
        "\n",
        "test_question = \"What is the AML alert threshold for cash deposits?\"\n",
        "chunks, metas = permission_filtered_search(test_question, current_role)\n",
        "\n",
        "if not chunks:\n",
        "    print(\"No accessible documents matched this question for this role.\")\n",
        "else:\n",
        "    for chunk, meta in zip(chunks, metas):\n",
        "        print(f\"[{meta['doc_id']}] (access: {meta['access_level']})\")\n",
        "        print(chunk[:150], \"...\\n\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "f40iXvpmw-yX",
        "outputId": "44756f4f-3e5d-46e9-949e-a102048fda18"
      },
      "execution_count": 18,
