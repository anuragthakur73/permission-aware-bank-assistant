    },
    {
      "cell_type": "code",
      "source": [
        "# RETRIEVAL SCORE: did the correct document(s) appear in what we retrieved?\n",
        "# This checks retrieval quality SEPARATELY from answer quality, exactly as\n",
        "# the video instructs. It does NOT call Gemini, so it's fast and free.\n",
        "\n",
        "def score_retrieval(row):\n",
        "    role = row[\"role\"]\n",
        "    question = row[\"question\"]\n",
        "    expected = row[\"expected_doc_ids\"]\n",
        "\n",
        "    chunks, metas = hybrid_search_with_rerank(question, role, n_candidates=15, n_final=5)\n",
        "    retrieved_doc_ids = set(m[\"doc_id\"] for m in metas)\n",
        "\n",
        "    if expected == \"NONE\":\n",
        "        # For refusals and gaps, PASS means we retrieved nothing the role\n",
        "        # shouldn't see, or nothing relevant at all (checked more precisely below).\n",
        "        return {\n",
        "            \"qid\": row[\"qid\"], \"category\": row[\"category\"], \"role\": role,\n",
        "            \"expected\": expected, \"retrieved\": \"; \".join(retrieved_doc_ids) or \"NONE\",\n",
        "            \"retrieval_pass\": len(retrieved_doc_ids) == 0\n",
        "        }\n",
        "    else:\n",
        "        expected_ids = set(d.strip() for d in expected.split(\";\"))\n",
        "        found_any = bool(expected_ids & retrieved_doc_ids)\n",
        "        return {\n",
        "            \"qid\": row[\"qid\"], \"category\": row[\"category\"], \"role\": role,\n",
        "            \"expected\": expected, \"retrieved\": \"; \".join(retrieved_doc_ids) or \"NONE\",\n",
        "            \"retrieval_pass\": found_any\n",
        "        }\n",
        "\n",
        "\n",
        "retrieval_results = [score_retrieval(row) for _, row in golden_df.iterrows()]\n",
        "retrieval_df = pd.DataFrame(retrieval_results)\n",
        "\n",
        "overall_score = retrieval_df[\"retrieval_pass\"].mean() * 100\n",
        "print(f\"Overall retrieval score: {overall_score:.1f}% ({retrieval_df['retrieval_pass'].sum()}/{len(retrieval_df)})\")\n",
        "print(\"\\nScore by category:\")\n",
        "print(retrieval_df.groupby(\"category\")[\"retrieval_pass\"].mean() * 100)\n",
        "\n",
        "print(\"\\nFailures (review these):\")\n",
        "retrieval_df[~retrieval_df[\"retrieval_pass\"]]"
      ],
      "metadata": {
        "id": "J0aB42W94cyk"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "import os\n",
        "import time\n",
        "import pandas as pd\n",
        "\n",
        "eval_output_path = os.path.join(project_folder, \"evaluation_results.csv\")\n",
        "\n",
        "if os.path.exists(eval_output_path):\n",
        "    existing_df = pd.read_csv(eval_output_path)\n",
        "    completed_qids = set(existing_df[\"qid\"])\n",
        "    print(f\"Found {len(completed_qids)} already-completed questions. Resuming from there.\")\n",
        "else:\n",
        "    existing_df = pd.DataFrame(columns=[\n",
        "        \"qid\", \"category\", \"role\", \"question\", \"expected_doc_ids\",\n",
        "        \"expected_behavior\", \"retrieved_doc_ids\", \"generated_answer\"\n",
        "    ])\n",
        "    completed_qids = set()\n",
        "    print(\"No previous results found. Starting fresh.\")\n",
        "\n",
        "for i, row in golden_df.iterrows():\n",
        "    if row[\"qid\"] in completed_qids:\n",
        "        continue\n",
        "\n",
        "    print(f\"Running {row['qid']} ({i+1}/{len(golden_df)})...\")\n",
        "\n",
        "    chunks, metas = hybrid_search_with_rerank(row[\"question\"], row[\"role\"], n_candidates=15, n_final=5)\n",
        "\n",
        "    if not chunks:\n",
        "        answer_text = (\"I don't have this information in the documents \"\n",
        "                        \"available to me, or you are not authorized to view \"\n",
        "                        \"documents relevant to this question.\")\n",
        "    else:\n",
        "        prompt = build_prompt(row[\"question\"], chunks, metas)\n",
        "        answer_text = None\n",
        "\n",
        "        for attempt in range(1, 5):  # retry up to 4 times for temporary issues\n",
        "            try:\n",
        "                response = gemini_client.models.generate_content(\n",
        "                    model=WORKING_MODEL, contents=prompt\n",
        "                )\n",
        "                answer_text = response.text\n",
        "                break  # success\n",
        "            except Exception as e:\n",
        "                if \"429\" in str(e) or \"RESOURCE_EXHAUSTED\" in str(e):\n",
        "                    print(f\"\\nQuota exhausted at {row['qid']}. Stopping here — \"\n",
        "                          f\"progress so far is already saved. Resume tomorrow.\")\n",
        "                    answer_text = None\n",
        "                    break\n",
        "                elif \"503\" in str(e) or \"UNAVAILABLE\" in str(e):\n",
        "                    wait_seconds = attempt * 5\n",
        "                    print(f\"  Server busy (attempt {attempt}/4). Waiting {wait_seconds}s...\")\n",
        "                    time.sleep(wait_seconds)\n",
        "                else:\n",
        "                    print(f\"  Unexpected error: {e}\")\n",
        "                    answer_text = None\n",
        "                    break\n",
        "\n",
        "        if answer_text is None:\n",
        "            print(f\"Could not get an answer for {row['qid']} this run. \"\n",
        "                  f\"It will be retried next time (not saved as an error).\")\n",
        "            # Stop the whole loop if it was a quota issue (no point continuing)\n",
        "            if \"429\" in str(locals().get('e', '')) or \"RESOURCE_EXHAUSTED\" in str(locals().get('e', '')):\n",
        "                break\n",
        "            continue  # skip saving this row, move to next question, retry it later\n",
        "\n",
        "    new_row = pd.DataFrame([{\n",
        "        \"qid\": row[\"qid\"],\n",
        "        \"category\": row[\"category\"],\n",
        "        \"role\": row[\"role\"],\n",
        "        \"question\": row[\"question\"],\n",
        "        \"expected_doc_ids\": row[\"expected_doc_ids\"],\n",
        "        \"expected_behavior\": row[\"expected_behavior\"],\n",
        "        \"retrieved_doc_ids\": \"; \".join(m[\"doc_id\"] for m in metas) if metas else \"NONE\",\n",
        "        \"generated_answer\": answer_text\n",
        "    }])\n",
        "\n",
        "    existing_df = pd.concat([existing_df, new_row], ignore_index=True)\n",
        "    existing_df.to_csv(eval_output_path, index=False)\n",
        "\n",
        "    log_query(row[\"role\"], row[\"question\"], answer_text, metas)\n",
        "\n",
        "print(f\"\\nDone for now. {len(existing_df)} / {len(golden_df)} questions completed.\")\n",
        "print(f\"Saved to: {eval_output_path}\")"
      ],
      "metadata": {
        "id": "_ISK3Iy45k9k"
      },
      "execution_count": null,
      "outputs": []
    },
