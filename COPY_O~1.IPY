    {
      "cell_type": "code",
      "source": [
        "# This creates a CSV log file in your Drive (or opens it if it already\n",
        "# exists from a previous session, so logs accumulate over time instead\n",
        "# of being overwritten).\n",
        "\n",
        "import csv\n",
        "from datetime import datetime\n",
        "\n",
        "log_path = os.path.join(project_folder, \"query_log.csv\")\n",
        "\n",
        "log_columns = [\n",
        "    \"timestamp\", \"role\", \"question\", \"answer\",\n",
        "    \"retrieved_doc_ids\", \"retrieved_access_levels\", \"num_chunks_used\"\n",
        "]\n",
        "\n",
        "# Create the file with headers only if it doesn't already exist\n",
        "if not os.path.exists(log_path):\n",
        "    with open(log_path, \"w\", newline=\"\", encoding=\"utf-8\") as f:\n",
        "        writer = csv.writer(f)\n",
        "        writer.writerow(log_columns)\n",
        "    print(f\"Created new log file at: {log_path}\")\n",
        "else:\n",
        "    print(f\"Found existing log file at: {log_path} (new entries will be added to it)\")"
      ],
      "metadata": {
        "id": "_hmZLYeyy7Z-"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def log_query(role, question, answer, metas):\n",
        "    \"\"\"Appends one row to the CSV log file, recording everything about\n",
        "    this question: who asked, what was retrieved, and what was answered.\"\"\"\n",
        "    doc_ids = \"; \".join(m[\"doc_id\"] for m in metas) if metas else \"NONE\"\n",
        "    access_levels = \"; \".join(sorted(set(m[\"access_level\"] for m in metas))) if metas else \"NONE\"\n",
        "\n",
        "    row = [\n",
        "        datetime.now().isoformat(timespec=\"seconds\"),\n",
        "        role,\n",
        "        question,\n",
        "        answer,\n",
        "        doc_ids,\n",
        "        access_levels,\n",
        "        len(metas) if metas else 0\n",
        "    ]\n",
        "\n",
        "    with open(log_path, \"a\", newline=\"\", encoding=\"utf-8\") as f:\n",
        "        writer = csv.writer(f)\n",
        "        writer.writerow(row)\n",
        "\n",
        "\n",
        "print(\"log_query() is ready.\")"
      ],
      "metadata": {
        "id": "jvUP5tF0zAQE"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Same as your existing ask_bank_assistant, with one addition: every\n",
        "# call now writes a row to the log, whether it succeeded, was refused,\n",
        "# or failed after retries. This makes the log a complete record, which\n",
        "# matters for the evaluation step later.\n",
        "\n",
        "def ask_bank_assistant(question, role, max_retries=4):\n",
        "    chunks, metas = hybrid_search_with_rerank(question, role, n_candidates=15, n_final=5)\n",
        "\n",
        "    if not chunks:\n",
        "        answer_text = (\"I don't have this information in the documents \"\n",
        "                        \"available to me, or you are not authorized to view \"\n",
        "                        \"documents relevant to this question.\")\n",
        "        print(\"ANSWER:\", answer_text)\n",
        "        log_query(role, question, answer_text, metas)\n",
        "        return\n",
        "\n",
        "    prompt = build_prompt(question, chunks, metas)\n",
        "\n",
        "    response = None\n",
        "    for attempt in range(1, max_retries + 1):\n",
        "        try:\n",
        "            response = gemini_client.models.generate_content(\n",
        "                model=\"gemini-3.6-flash\",\n",
        "                contents=prompt\n",
        "            )\n",
        "            break\n",
        "        except Exception as e:\n",
        "            if \"503\" in str(e) or \"UNAVAILABLE\" in str(e):\n",
        "                wait_seconds = attempt * 5\n",
        "                print(f\"Model busy (attempt {attempt}/{max_retries}). \"\n",
        "                      f\"Waiting {wait_seconds} seconds before retrying...\")\n",
        "                time.sleep(wait_seconds)\n",
        "            else:\n",
        "                raise\n",
        "\n",
        "    if response is None:\n",
        "        answer_text = \"ERROR: Gemini's servers stayed busy after several retries.\"\n",
        "        print(\"ANSWER:\", answer_text)\n",
        "        log_query(role, question, answer_text, metas)\n",
        "        return\n",
        "\n",
        "    answer_text = response.text\n",
        "\n",
        "    print(\"=\" * 70)\n",
        "    print(f\"ROLE: {role}\")\n",
        "    print(f\"QUESTION: {question}\")\n",
        "    print(\"=\" * 70)\n",
        "    print(\"\\nANSWER:\\n\")\n",
        "    print(answer_text)\n",
        "    print(\"\\n\" + \"-\" * 70)\n",
        "    print(\"Sources retrieved (for reference):\")\n",
        "    for meta in metas:\n",
        "        print(f\"  - {meta['doc_id']} | {meta['access_level']} | {meta['status']}\")\n",
        "\n",
        "    log_query(role, question, answer_text, metas)\n",
