    {
      "cell_type": "code",
      "source": [
        "CANDIDATE_MODELS = [\n",
        "    \"gemini-2.5-flash-lite\",\n",
        "    \"gemini-flash-lite-latest\",\n",
        "    \"gemini-3.1-flash-lite\",\n",
        "    \"gemini-2.5-flash\",\n",
        "    \"gemini-flash-latest\",\n",
        "]\n",
        "\n",
        "WORKING_MODEL = None\n",
        "\n",
        "for model_name in CANDIDATE_MODELS:\n",
        "    try:\n",
        "        test_response = gemini_client.models.generate_content(\n",
        "            model=model_name,\n",
        "            contents=\"Say OK\"\n",
        "        )\n",
        "        print(f\"✓ {model_name} WORKS. Response: {test_response.text.strip()}\")\n",
        "        WORKING_MODEL = model_name\n",
        "        break\n",
        "    except Exception as e:\n",
        "        print(f\"✗ {model_name} failed: {str(e)[:100]}\")\n",
        "\n",
        "print(f\"\\nUsing '{WORKING_MODEL}'\" if WORKING_MODEL else \"\\nNone worked.\")"
      ],
      "metadata": {
