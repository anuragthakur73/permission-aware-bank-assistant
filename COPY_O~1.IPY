    {
      "cell_type": "code",
      "source": [
        "# Your files use \"=====DOC=====\" as a divider between documents.\n",
        "# This cell splits the big block of text into 40 separate documents,\n",
        "# and reads each document's labels (doc_id, access_level, etc).\n",
        "\n",
        "raw_docs = [d.strip() for d in all_text.split(\"=====DOC=====\") if d.strip()]\n",
        "\n",
        "documents = []  # will hold one dictionary per document\n",
        "\n",
        "for raw in raw_docs:\n",
        "    # Separate the header (labels) from the body (the actual text)\n",
        "    header_part, body_part = raw.split(\"text:\", 1)\n",
        "\n",
        "    # Turn the header lines into a dictionary, e.g. {\"doc_id\": \"POL-001\", ...}\n",
        "    metadata = {}\n",
        "    for line in header_part.strip().splitlines():\n",
        "        if \": \" in line:\n",
        "            key, value = line.split(\": \", 1)\n",
        "            metadata[key.strip()] = value.strip()\n",
        "\n",
        "    metadata[\"text\"] = body_part.strip()\n",
        "    documents.append(metadata)\n",
        "\n",
        "print(f\"Parsed {len(documents)} documents.\")\n",
        "print(\"\\nExample of one parsed document:\")\n",
        "print(documents[0])"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "kPguKcDAvzYk",
        "outputId": "ede0b12a-9160-4a2e-9577-d18e2f9af742"
      },
      "execution_count": 12,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Parsed 40 documents.\n",
            "\n",
            "Example of one parsed document:\n",
            "{'doc_id': 'POL-001', 'title': 'Sahyadri Griha Suvidha - Home Loan Product Brochure', 'source_type': 'policy', 'department': 'Retail Assets', 'date': '2025-11-10', 'access_level': 'Public', 'status': 'current', 'account': 'N/A', 'text': \"SAHYADRI UNION BANK - SAHYADRI GRIHA SUVIDHA HOME LOAN\\n\\nOwn your home with a loan designed for salaried and self-employed families.\\n\\nKey features\\n- Loan amount: up to Rs. 5 crore.\\n- Interest rate: starting from 8.35% per annum, floating, linked to the bank's Repo Linked Lending Rate (SRLLR). The final rate depends on the applicant's credit profile.\\n- Tenure: up to 30 years, subject to the borrower being no older than 65 years at the end of the loan.\\n- Financing: up to 90% of property cost for loans up to Rs. 30 lakh; up to 80% for loans from Rs. 30 lakh to Rs. 75 lakh; up to 75% for loans above Rs. 75 lakh.\\n- Processing fee: 0.50% of the loan amount plus GST, subject to a maximum of Rs. 15,000 plus GST.\\n\\nWho can apply\\nResident Indian salaried employees with at least 2 years of work experience, and self-employed professionals and business owners with at least 3 years of business continuity.\\n\\nDocuments required\\n- Identity and address proof (as per KYC norms)\\n- Last 3 months' salary slips and 6 months' bank statements (salaried), or last 3 years' income tax returns with financial statements (self-employed)\\n- Property documents, including sale agreement and title papers\\n\\nHome loan protection insurance\\nLoan protection insurance from our bancassurance partners is available but is completely optional. Your loan sanction does not depend on buying any insurance product.\\n\\nVisit any Sahyadri Union Bank branch or call our customer care number to apply. Terms and conditions apply.\"}\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# Chunking = cutting each document into smaller pieces (paragraphs),\n",
        "# so the AI can find the exact relevant piece instead of the whole document.\n",
        "# Every chunk keeps the same labels as its parent document.\n",
        "\n",
        "def split_into_chunks(text, max_words=100):\n",
        "    \"\"\"Splits text into chunks of roughly max_words words, breaking at\n",
        "    paragraph boundaries where possible.\"\"\"\n",
        "    paragraphs = [p.strip() for p in text.split(\"\\n\") if p.strip()]\n",
        "    chunks = []\n",
        "    current_chunk = []\n",
        "    current_word_count = 0\n",
        "\n",
        "    for para in paragraphs:\n",
        "        para_word_count = len(para.split())\n",
        "        if current_word_count + para_word_count > max_words and current_chunk:\n",
        "            chunks.append(\" \".join(current_chunk))\n",
        "            current_chunk = []\n",
        "            current_word_count = 0\n",
        "        current_chunk.append(para)\n",
        "        current_word_count += para_word_count\n",
        "\n",
        "    if current_chunk:\n",
        "        chunks.append(\" \".join(current_chunk))\n",
        "\n",
        "    return chunks\n",
        "\n",
        "\n",
        "all_chunks = []       # the actual text pieces\n",
        "all_metadata = []     # the labels for each piece\n",
        "all_ids = []          # a unique ID for each piece\n",
        "\n",
        "for doc in documents:\n",
        "    chunks = split_into_chunks(doc[\"text\"], max_words=100)\n",
        "    for i, chunk_text in enumerate(chunks):\n",
        "        chunk_id = f\"{doc['doc_id']}-chunk{i+1}\"\n",
        "        all_ids.append(chunk_id)\n",
        "        all_chunks.append(chunk_text)\n",
        "        # Copy every label except the full text (we don't need to duplicate it)\n",
        "        chunk_metadata = {k: v for k, v in doc.items() if k != \"text\"}\n",
        "        all_metadata.append(chunk_metadata)\n",
        "\n",
        "print(f\"Created {len(all_chunks)} chunks from {len(documents)} documents.\")\n",
        "print(\"\\nExample chunk:\")\n",
        "print(\"ID:\", all_ids[0])\n",
        "print(\"Metadata:\", all_metadata[0])\n",
        "print(\"Text:\", all_chunks[0][:200], \"...\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "PzUlzY8xv3tF",
        "outputId": "93749523-a8bf-4418-b0b1-dfcd82c65f16"
      },
      "execution_count": 13,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Created 123 chunks from 40 documents.\n",
            "\n",
            "Example chunk:\n",
            "ID: POL-001-chunk1\n",
            "Metadata: {'doc_id': 'POL-001', 'title': 'Sahyadri Griha Suvidha - Home Loan Product Brochure', 'source_type': 'policy', 'department': 'Retail Assets', 'date': '2025-11-10', 'access_level': 'Public', 'status': 'current', 'account': 'N/A'}\n",
            "Text: SAHYADRI UNION BANK - SAHYADRI GRIHA SUVIDHA HOME LOAN Own your home with a loan designed for salaried and self-employed families. Key features - Loan amount: up to Rs. 5 crore. - Interest rate: start ...\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# ChromaDB is a free local database built for AI search.\n",
        "# This cell converts each chunk into \"embeddings\" (numbers representing\n",
        "# meaning) and stores them along with their labels (source, department,\n",
        "# access_level, etc). This may take 1-2 minutes the first time, since it\n",
        "# downloads a small AI model to create the embeddings.\n",
        "\n",
        "import chromadb\n",
        "from chromadb.utils import embedding_functions\n",
        "\n",
        "# Use a free, well-known embedding model that runs on Colab's free CPU\n",
        "embedding_fn = embedding_functions.SentenceTransformerEmbeddingFunction(\n",
        "    model_name=\"all-MiniLM-L6-v2\"\n",
        ")\n",
        "\n",
        "# Create a database that lives in this Colab session\n",
        "chroma_client = chromadb.Client()\n",
        "\n",
        "# Create (or reset) our collection of bank document chunks\n",
        "collection_name = \"sahyadri_bank_docs\"\n",
        "try:\n",
        "    chroma_client.delete_collection(collection_name)\n",
        "except Exception:\n",
        "    pass  # collection didn't exist yet, that's fine\n",
        "\n",
        "collection = chroma_client.create_collection(\n",
        "    name=collection_name,\n",
        "    embedding_function=embedding_fn\n",
        ")\n",
        "\n",
        "# Add everything in one batch\n",
        "collection.add(\n",
        "    ids=all_ids,\n",
        "    documents=all_chunks,\n",
        "    metadatas=all_metadata\n",
        ")\n",
        "\n",
        "print(f\"Stored {collection.count()} chunks in ChromaDB.\")"
      ],
