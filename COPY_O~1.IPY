    },
    {
      "cell_type": "code",
      "source": [
        "# This proves the filtering actually works. Run this cell as-is —\n",
        "# it tests THREE roles automatically against a question that only\n",
        "# Compliance should be able to answer (the AML alert threshold, which\n",
        "# lives only in AML-Confidential documents).\n",
        "\n",
        "leak_test_question = \"What is the AML alert threshold for cash deposits?\"\n",
        "\n",
        "print(\"=\" * 60)\n",
        "print(\"LEAK TEST: asking a Compliance-only question as every role\")\n",
        "print(\"=\" * 60)\n",
        "\n",
        "for role in ROLE_PERMISSIONS:\n",
        "    chunks, metas = permission_filtered_search(leak_test_question, role, n_results=5)\n",
        "    leaked = [m for m in metas if m[\"access_level\"] == \"AML-Confidential\"]\n",
        "\n",
        "    print(f\"\\nRole: {role}\")\n",
        "    print(f\"  Chunks returned: {len(chunks)}\")\n",
        "    print(f\"  AML-Confidential chunks leaked: {len(leaked)}\")\n",
        "\n",
        "    if role != \"compliance_officer\" and leaked:\n",
        "        print(\"  *** FAIL: this role should NEVER see AML-Confidential content! ***\")\n",
        "    elif role == \"compliance_officer\" and not leaked:\n",
        "        print(\"  Note: no AML chunk matched this specific question, that's OK.\")\n",
        "    else:\n",
        "        print(\"  PASS: no unauthorized content returned.\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
