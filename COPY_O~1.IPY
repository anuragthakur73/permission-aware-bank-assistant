    {
      "cell_type": "code",
      "source": [
        "# This checks that your three files are visible to Colab.\n",
        "# If you see an error here, re-upload the files using the folder icon\n",
        "# on the left sidebar, then run this cell again.\n",
        "\n",
        "import os\n",
        "\n",
        "filenames = [\"batch1_policies.txt\", \"batch2_calls.txt\", \"batch3_chats.txt\"]\n",
        "all_text = \"\"\n",
        "\n",
        "for fname in filenames:\n",
        "    if not os.path.exists(fname):\n",
        "        raise FileNotFoundError(\n",
        "            f\"'{fname}' not found. Please upload it using the folder icon \"\n",
        "            \"on the left, then run this cell again.\"\n",
        "        )\n",
        "    with open(fname, \"r\", encoding=\"utf-8\") as f:\n",
        "        all_text += f.read() + \"\\n\"\n",
        "\n",
        "print(f\"Successfully read {len(filenames)} files.\")\n",
        "print(f\"Total characters read: {len(all_text)}\")"
      ],
