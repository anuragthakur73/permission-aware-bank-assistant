    {
      "cell_type": "code",
      "source": [
        "# Simulates what happens in real banking systems: a customer's information\n",
        "# gets reclassified after a compliance event (here: an AML risk rating\n",
        "# change following the review documented in CHAT-012).\n",
        "#\n",
        "# This function updates the access_level of specific chunks in ChromaDB\n",
        "# directly - representing what a real system would do the moment\n",
        "# Compliance approves a risk rating change.\n",
        "\n",
        "def escalate_access_level(doc_ids, new_access_level, reason):\n",
        "    \"\"\"\n",
        "    Updates the access_level metadata for one or more documents already\n",
        "    stored in ChromaDB, simulating a real-time reclassification event.\n",
        "    \"\"\"\n",
        "    for doc_id in doc_ids:\n",
        "        # Find every chunk belonging to this document\n",
        "        matching_ids = [cid for cid, meta in zip(all_ids, all_metadata) if meta[\"doc_id\"] == doc_id]\n",
        "\n",
        "        if not matching_ids:\n",
        "            print(f\"Warning: no chunks found for {doc_id}\")\n",
        "            continue\n",
        "\n",
        "        # Fetch current records so we can update them in place\n",
        "        existing = collection.get(ids=matching_ids)\n",
        "\n",
        "        updated_metadatas = []\n",
        "        for meta in existing[\"metadatas\"]:\n",
        "            new_meta = dict(meta)\n",
        "            new_meta[\"access_level\"] = new_access_level\n",
        "            new_meta[\"reclassification_reason\"] = reason\n",
        "            updated_metadatas.append(new_meta)\n",
        "\n",
        "        collection.update(ids=matching_ids, metadatas=updated_metadatas)\n",
        "\n",
        "        # Also update our in-memory copy so later cells stay consistent\n",
        "        for i, meta in enumerate(all_metadata):\n",
        "            if meta[\"doc_id\"] == doc_id:\n",
        "                all_metadata[i][\"access_level\"] = new_access_level\n",
        "                all_metadata[i][\"reclassification_reason\"] = reason\n",
        "\n",
        "        print(f\"{doc_id}: access_level changed to '{new_access_level}' ({len(matching_ids)} chunks updated)\")\n",
        "\n",
        "\n",
        "print(\"escalate_access_level() is ready.\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "RgVqCuhSVzp9",
        "outputId": "566f2a48-ddcd-4f8d-878e-c92eb2ffa6c8"
      },
      "execution_count": 35,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "escalate_access_level() is ready.\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# BEFORE the escalation: CALL-012 (Imran Shaikh's routine KYC call) is\n",
