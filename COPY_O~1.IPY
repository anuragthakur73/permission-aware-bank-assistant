    {
      "cell_type": "code",
      "source": [
        "leak_test_question = \"What is the AML alert threshold for cash deposits?\"\n",
        "\n",
        "print(\"=\" * 60)\n",
        "print(\"LEAK TEST: asking a Compliance-only question as every role\")\n",
        "print(\"=\" * 60)\n",
        "\n",
        "for role in ROLE_PERMISSIONS:\n",
        "    chunks, metas = permission_filtered_search(leak_test_question, role, n_results=5)\n",
        "    aml_chunks = [m for m in metas if m[\"access_level\"] == \"AML-Confidential\"]\n",
        "    is_authorized = \"AML-Confidential\" in get_allowed_access_levels(role)\n",
        "\n",
        "    print(f\"\\nRole: {role}\")\n",
        "    print(f\"  Chunks returned: {len(chunks)}\")\n",
        "    print(f\"  AML-Confidential chunks in results: {len(aml_chunks)}\")\n",
        "\n",
        "    if aml_chunks and not is_authorized:\n",
        "        print(\"  *** FAIL: this role should NEVER see AML-Confidential content! ***\")\n",
        "    elif aml_chunks and is_authorized:\n",
        "        print(\"  PASS: authorized role correctly retrieved AML-Confidential content.\")\n",
        "    else:\n",
        "        print(\"  PASS: no unauthorized content returned (none matched, or none was AML-Confidential).\")"
      ],
