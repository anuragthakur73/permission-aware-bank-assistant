    {
      "cell_type": "code",
      "source": [
        "# This is the instruction we send to Gemini along with the retrieved\n",
        "# chunks. The wording here directly implements the video's rules:\n",
        "# - answer ONLY from what's provided\n",
        "# - cite every claim\n",
        "# - say \"I don't know\" if it's not there\n",
        "# - warn if something is confidential and shouldn't go to a customer\n",
        "\n",
        "SYSTEM_INSTRUCTION = \"\"\"You are an internal assistant for Sahyadri Union Bank staff.\n",
        "\n",
        "STRICT RULES:\n",
        "1. Answer ONLY using the document excerpts provided below. Do not use any\n",
        "   outside knowledge, even if you think you know the answer.\n",
        "2. For every factual claim, cite the source document ID in square brackets,\n",
        "   like this: [POL-002] or [CALL-007].\n",
        "3. If the excerpts contain conflicting information (e.g. two different fee\n",
        "   amounts), point out the conflict explicitly, and prefer the document\n",
        "   with the most recent date or the one marked \"status: current\" over one\n",
        "   marked \"status: superseded\".\n",
        "4. If the answer is not contained in the excerpts provided, say clearly:\n",
        "   \"I don't have this information in the documents available to me.\" Do\n",
        "   not guess or fill gaps with general knowledge.\n",
        "5. If any excerpt is marked access_level \"Credit-Confidential\" or\n",
        "   \"AML-Confidential\", add a warning at the end of your answer:\n",
        "   \"Note: this answer includes confidential internal information and\n",
        "   must not be shared with the customer.\"\n",
        "6. Be concise and factual. Do not add opinions or advice beyond what the\n",
        "   documents state.\n",
        "\"\"\"\n",
        "\n",
        "def build_prompt(question, chunks, metas):\n",
        "    \"\"\"Combines the question and retrieved chunks into one prompt for Gemini.\"\"\"\n",
        "    excerpt_text = \"\"\n",
        "    for chunk, meta in zip(chunks, metas):\n",
        "        excerpt_text += (\n",
        "            f\"\\n--- Excerpt from {meta['doc_id']} \"\n",
        "            f\"(title: {meta['title']}, date: {meta['date']}, \"\n",
        "            f\"status: {meta['status']}, access_level: {meta['access_level']}) ---\\n\"\n",
        "            f\"{chunk}\\n\"\n",
        "        )\n",
        "\n",
        "    prompt = f\"\"\"{SYSTEM_INSTRUCTION}\n",
        "\n",
        "DOCUMENT EXCERPTS:\n",
        "{excerpt_text}\n",
        "\n",
        "QUESTION: {question}\n",
        "\n",
        "ANSWER:\"\"\"\n",
        "    return prompt\n",
        "\n",
        "\n",
        "print(\"Prompt builder ready.\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "D03tBKNcx-qE",
        "outputId": "e700d161-04eb-4b7d-8c1e-12319f56b0ed"
      },
      "execution_count": 28,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Prompt builder ready.\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "def ask_bank_assistant(question, role):\n",
        "    \"\"\"\n",
        "    The complete pipeline:\n",
        "    1. Retrieve permission-filtered, reranked chunks for this role.\n",
        "    2. If nothing was retrieved, refuse without calling the AI.\n",
        "    3. Otherwise, build a grounded prompt and call Gemini.\n",
        "    4. Print the answer along with which sources were used.\n",
        "    \"\"\"\n",
        "    chunks, metas = hybrid_search_with_rerank(question, role, n_candidates=15, n_final=5)\n",
        "\n",
        "    if not chunks:\n",
        "        print(\"ANSWER: I don't have this information in the documents \"\n",
        "              \"available to me, or you are not authorized to view \"\n",
        "              \"documents relevant to this question.\")\n",
        "        return\n",
        "\n",
        "    prompt = build_prompt(question, chunks, metas)\n",
        "\n",
        "    response = gemini_client.models.generate_content(\n",
        "        model=\"gemini-flash-latest\",\n",
        "        contents=prompt\n",
        "    )\n",
        "\n",
        "    print(\"=\" * 70)\n",
        "    print(f\"ROLE: {role}\")\n",
        "    print(f\"QUESTION: {question}\")\n",
        "    print(\"=\" * 70)\n",
        "    print(\"\\nANSWER:\\n\")\n",
        "    print(response.text)\n",
        "    print(\"\\n\" + \"-\" * 70)\n",
        "    print(\"Sources retrieved (for reference):\")\n",
        "    for meta in metas:\n",
        "        print(f\"  - {meta['doc_id']} | {meta['access_level']} | {meta['status']}\")\n",
        "\n",
        "\n",
        "print(\"ask_bank_assistant() is ready.\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "r0oCizgJyG7Y",
        "outputId": "2b457008-4b9b-4200-fcd5-98aa2283618e"
      },
      "execution_count": 29,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "ask_bank_assistant() is ready.\n"
          ]
        }
      ]
    },
