    {
      "cell_type": "code",
      "source": [
        "# This just checks that search works at all, before we add permission\n",
        "# filtering in the next step. It should return chunks about home loans.\n",
        "\n",
        "results = collection.query(\n",
        "    query_texts=[\"What is the home loan processing fee?\"],\n",
        "    n_results=3\n",
        ")\n",
        "\n",
        "for i, (doc, meta) in enumerate(zip(results[\"documents\"][0], results[\"metadatas\"][0])):\n",
        "    print(f\"--- Result {i+1} ---\")\n",
        "    print(\"From:\", meta[\"doc_id\"], \"| Access level:\", meta[\"access_level\"])\n",
        "    print(doc[:200], \"...\\n\")"
      ],
