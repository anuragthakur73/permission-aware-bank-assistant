        "# Re-run the leak test using the new hybrid+rerank function, not just\n",
        "# the plain semantic search, to make sure permission filtering still\n",
        "# holds after adding BM25 and reranking.\n",
        "\n",
        "leak_test_question = \"What is the AML alert threshold for cash deposits?\"\n",
        "\n",
        "for role in ROLE_PERMISSIONS:\n",
        "    chunks, metas = hybrid_search_with_rerank(leak_test_question, role)\n",
        "    aml_chunks = [m for m in metas if m[\"access_level\"] == \"AML-Confidential\"]\n",
        "    is_authorized = \"AML-Confidential\" in get_allowed_access_levels(role)\n",
        "\n",
        "    print(f\"Role: {role} | AML chunks returned: {len(aml_chunks)}\", end=\" \")\n",
        "    if aml_chunks and not is_authorized:\n",
        "        print(\"*** FAIL ***\")\n",
        "    else:\n",
        "        print(\"PASS\")"
