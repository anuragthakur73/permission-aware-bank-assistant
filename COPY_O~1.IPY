    {
      "cell_type": "code",
      "source": [
        "# BM25 is a well-established keyword search algorithm - it's what\n",
        "# traditional search engines used before semantic search existed.\n",
        "# We build one index per access level combination isn't practical, so\n",
        "# instead we build ONE index over everything, then filter results\n",
        "# afterward by matching to allowed doc_ids. This is fine at our scale\n",
        "# (a few hundred chunks).\n",
        "\n",
        "from rank_bm25 import BM25Okapi\n",
        "\n",
        "# Tokenize each chunk (simple lowercase word splitting)\n",
        "tokenized_chunks = [chunk.lower().split() for chunk in all_chunks]\n",
        "\n",
        "bm25_index = BM25Okapi(tokenized_chunks)\n",
        "\n",
        "print(f\"BM25 keyword index built over {len(all_chunks)} chunks.\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "TzdzdB-KxLm2",
        "outputId": "c34ae3e1-067c-411d-ff6d-c5aa6c8b3fbc"
      },
      "execution_count": 21,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "BM25 keyword index built over 123 chunks.\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# A \"cross-encoder\" reranker looks at the question and one chunk TOGETHER\n",
        "# and gives a relevance score. This is slower than regular search, so we\n",
        "# only use it on a short list of candidates (e.g. top 15), not everything.\n",
        "# This downloads a small free model the first time you run it.\n",
        "\n",
        "from sentence_transformers import CrossEncoder\n",
        "\n",
        "reranker = CrossEncoder(\"cross-encoder/ms-marco-MiniLM-L-6-v2\")\n",
        "\n",
        "print(\"Reranker model loaded.\")"
      ],
      "metadata": {
