      "source": [
        "import pandas as pd\n",
        "\n",
        "golden_path = os.path.join(project_folder, \"golden_dataset.csv\")\n",
        "golden_df = pd.read_csv(golden_path)\n",
        "\n",
        "print(f\"Loaded {len(golden_df)} golden questions.\")\n",
        "golden_df.head()"
      ],
      "metadata": {
        "id": "MPKYW4VU1oyL"
