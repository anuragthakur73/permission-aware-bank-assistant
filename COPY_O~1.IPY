        "\n",
        "found = [m[\"doc_id\"] for m in metas]\n",
        "print(\"BEFORE escalation - branch_officer retrieved:\", found)\n",
        "print(\"CALL-012 accessible to branch_officer:\", \"CALL-012\" in found)"
