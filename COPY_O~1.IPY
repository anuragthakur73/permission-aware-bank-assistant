    {
      "cell_type": "code",
      "source": [
        "# This runs the COMPLETE pipeline (including Gemini) for every question,\n",
        "# so you get real answers to read and judge yourself. This will take a\n",
        "# few minutes and uses your Gemini free-tier quota, so run it once you're\n",
        "# fairly confident, not on every small code change.\n",
        "\n",
        "import time\n",
        "\n",
        "full_results = []\n",
        "\n",
        "for i, row in golden_df.iterrows():\n",
        "    print(f\"Running {row['qid']} ({i+1}/{len(golden_df)})...\")\n",
        "    chunks, metas = hybrid_search_with_rerank(row[\"question\"], row[\"role\"], n_candidates=15, n_final=5)\n",
        "\n",
        "    if not chunks:\n",
        "        answer_text = (\"I don't have this information in the documents \"\n",
        "                        \"available to me, or you are not authorized to view \"\n",
        "                        \"documents relevant to this question.\")\n",
        "    else:\n",
        "        prompt = build_prompt(row[\"question\"], chunks, metas)\n",
        "        response = None\n",
        "        for attempt in range(1, 4):\n",
        "            try:\n",
        "                response = gemini_client.models.generate_content(\n",
        "                    model=\"gemini-flash-latest\", contents=prompt\n",
        "                )\n",
        "                break\n",
        "            except Exception as e:\n",
        "                if \"503\" in str(e) or \"UNAVAILABLE\" in str(e):\n",
        "                    time.sleep(attempt * 5)\n",
        "                else:\n",
        "                    raise\n",
        "        answer_text = response.text if response else \"ERROR: model busy after retries\"\n",
        "\n",
        "    full_results.append({\n",
        "        \"qid\": row[\"qid\"],\n",
        "        \"category\": row[\"category\"],\n",
        "        \"role\": row[\"role\"],\n",
        "        \"question\": row[\"question\"],\n",
        "        \"expected_doc_ids\": row[\"expected_doc_ids\"],\n",
        "        \"expected_behavior\": row[\"expected_behavior\"],\n",
        "        \"retrieved_doc_ids\": \"; \".join(m[\"doc_id\"] for m in metas) if metas else \"NONE\",\n",
        "        \"generated_answer\": answer_text\n",
        "    })\n",
        "\n",
        "    log_query(row[\"role\"], row[\"question\"], answer_text, metas)  # also adds to your audit log\n",
        "\n",
        "full_results_df = pd.DataFrame(full_results)\n",
        "\n",
        "# Save this for manual review\n",
        "eval_output_path = os.path.join(project_folder, \"evaluation_results.csv\")\n",
        "full_results_df.to_csv(eval_output_path, index=False)\n",
        "\n",
        "print(f\"\\nDone. Saved full results to: {eval_output_path}\")"
      ],
